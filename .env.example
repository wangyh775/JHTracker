# JHTracker 环境变量配置示例
# 复制为 .env 并按需修改，或直接在系统环境变量中设置

# 运行环境：development（默认，开启 DEBUG）/ production（关闭 DEBUG）
FLASK_ENV=development

# Flask 调试模式（开发时设 1，生产留空；优先级低于 FLASK_ENV）
FLASK_DEBUG=0

# Flask SECRET_KEY（不设则自动生成并持久化到 data/.secret_key）
# SECRET_KEY=your-secret-key-here

# 数据目录位置（默认为项目内 data/）
# JH_DATA_DIR=/path/to/your/data

# 公司清单数据源目录（默认为项目内 career_data/）
# CAREER_DIR=/path/to/your/career_data

# === AI 评分配置（可选）===
# 提供商：anthropic / openai
AI_PROVIDER=anthropic
# 模型名
AI_MODEL=claude-sonnet-4-20250514
# API Key（二选一）
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# 仅 openai 兼容接口需要（如中转站）
# AI_BASE_URL=https://api.openai.com/v1
