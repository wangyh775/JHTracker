{
  "manifest_version": 3,
  "name": "Hermes Career Autofill Agent",
  "version": "1.0.0",
  "description": "伴随式本地网申智能体插件：支持4轨简历绑定、跨步骤感知、拟人防作弊打字与CDP文件挂载",
  "permissions": [
    "activeTab",
    "storage",
    "debugger",
    "scripting"
  ],
  "host_permissions": [
    "http://127.0.0.1:5000/*",
    "http://localhost:5000/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "typing-engine.js",
        "form-detector.js",
        "wizard-observer.js",
        "widget.js",
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Hermes Career Agent",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
